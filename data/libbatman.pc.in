prefix=@PREFIX@
exec_prefix=${prefix}
libdir=@LIBDIR@
includedir=@INCLUDEDIR@

Name: libbatman
Description: Platform-agnostic power tuning engine for Halium/Android devices
Version: @VERSION@
Libs: -L${libdir} -lbatman
Cflags: -I${includedir}/batman
Requires: glib-2.0 gio-2.0 libgbinder libnl-3.0 libnl-genl-3.0 libnl-route-3.0
